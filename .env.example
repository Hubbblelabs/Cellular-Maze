# Cellular Maze backend -- copy to `.env` in the repo root.
# Every key is optional: without them the app uses OSRM for real road routes,
# the bundled OpenCelliD tower snapshot, and neutral weather.

# Live-traffic routing (https://developer.tomtom.com) -- preferred over OSRM when set
TOMTOM_API_KEY=
# Live cell-tower lookups along each route (https://opencellid.org)
OPENCELLID_API_KEY=
# Real-time weather impact on signal (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# JWT signing secret -- set a long random value in any shared deployment
SECRET_KEY=

# Keyless routing fallback (public demo server; self-host for production)
OSRM_URL=https://router.project-osrm.org

# Extra allowed browser origin (localhost:3000 is always allowed)
CORS_ORIGIN=

# Optional MongoDB for persistent RL profiles / v1 auth
MONGO_URI=mongodb://localhost:27017
DB_NAME=cellularmaze
